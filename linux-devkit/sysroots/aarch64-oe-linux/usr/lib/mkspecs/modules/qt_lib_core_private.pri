QT.core_private.VERSION = 5.15.13
QT.core_private.name = QtCore
QT.core_private.module =
QT.core_private.libs = $$QT_MODULE_LIB_BASE
QT.core_private.includes = $$QT_MODULE_INCLUDE_BASE/QtCore/5.15.13 $$QT_MODULE_INCLUDE_BASE/QtCore/5.15.13/QtCore
QT.core_private.frameworks =
QT.core_private.depends = core
QT.core_private.uses =
QT.core_private.module_config = v2 internal_module
QT.core_private.enabled_features = clock-gettime datetimeparser doubleconversion futimens getauxval glibc hijricalendar icu inotify linkat mimetype-database system-pcre2 poll_ppoll renameat2 sha3-fast statx
