prefix=/usr
exec_prefix=${prefix}
libdir=/usr/lib
includedir=/usr/include


Name: Qt5 Location
Description: Qt Location module
Version: 5.15.13
Libs: -L${libdir} -lQt5Location 
Cflags: -DQT_LOCATION_LIB -I${includedir}/QtLocation -I${includedir}
Requires: Qt5Core Qt5Positioning Qt5PositioningQuick Qt5Gui Qt5Quick Qt5Network Qt5Qml

